<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoftwareDefinedPlc</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Tests live in tests/ and are built by their own project. -->
    <Compile Remove="tests/**" />
    <InternalsVisibleTo Include="SoftwareDefinedPlc.Tests" />
  </ItemGroup>
</Project>
